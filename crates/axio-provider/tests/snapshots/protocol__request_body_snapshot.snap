---
source: crates/axio-provider/tests/protocol.rs
expression: build_body(&sample_request())
---
{
  "model": "claude-opus-5",
  "max_tokens": 64000,
  "stream": true,
  "system": [
    {
      "type": "text",
      "text": "You are axio."
    },
    {
      "type": "text",
      "text": "Platform: linux, shell: zsh.",
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "review src/lib.rs"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "read",
      "description": "Read a file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bash",
      "description": "Run a command.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ]
      },
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "output_config": {
    "effort": "xhigh"
  },
  "thinking": {
    "type": "adaptive",
    "display": "summarized"
  }
}
