{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "axio",
  "version": "0.1.0",
  "identifier": "sh.axio.app",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "axio",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 540,
        "decorations": false,
        "resizable": true,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "color": [
            8,
            9,
            12,
            190
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
